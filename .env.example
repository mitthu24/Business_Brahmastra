# 90-Day Business School - Phase 4 (user accounts + cloud progress)
#
# As of Phase 4 this app requires a Postgres database. Copy this file to
# .env.local and fill in real values for local development. See docs/PHASE-4.md
# for full setup/deployment instructions. Never commit a file with real
# secrets in it.

# Postgres connection string (required). Any standard Postgres provider works
# (Vercel Postgres / Neon / Supabase / a local Postgres server), e.g.:
#   postgres://user:password@host:5432/dbname
DATABASE_URL=

# Public base URL of the deployed app, used to build password-reset links.
# Defaults to http://localhost:3000 in development if unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email delivery (not wired up in Phase 4 - see docs/PHASE-4.md) ---
# These are documented for the next phase but are not read by any code path
# yet. Password reset links are currently only logged server-side (console.log)
# instead of being emailed. Leave unset.
EMAIL_FROM=
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
